# === Secrets — NEVER commit ===
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
src/*.egg-info/
# `.venv*` rather than `.venv`: one venv per kernel, because a venv bakes in
# its layout and its interpreter's path. Windows builds .venv, WSL/Linux
# builds .venv-linux — see the Makefile.
.venv*/
venv/
dist/
build/

# Cached zoning PDFs and anything else downloaded at runtime
data/

# Streamlit
.streamlit/secrets.toml

# Lock-files are generated; commit them deliberately, not by accident
requirements-docker.lock.txt

# Tooling
.pytest_cache/
.ruff_cache/
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Vendored by `make db-image-src` for docker/postgres.Dockerfile
docker/pgvector-src.tar.gz
