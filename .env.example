# ---------------------------------------------------------------------------
# HuggingFace
# ---------------------------------------------------------------------------
# One token, two uses: the chat model and the query encoder.
#   https://huggingface.co/settings/tokens   (Inference API access required)
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Chat model. A short alias from src/config.py MODELS, or a full repo ID.
# Unset, the default is qwen2.5-72b — the by-law and every grid are in French,
# and that is the strongest multilingual model in the catalog.
#
#   qwen2.5-72b     Qwen/Qwen2.5-72B-Instruct     (default)
#   gpt-oss-120b    openai/gpt-oss-120b
#   gpt-oss-20b     openai/gpt-oss-20b
#   gemma-3-27b     google/gemma-3-27b-it         (*)
#
# (*) Requires accepting Google's licence on HuggingFace first.
#HF_MODEL_ID=qwen2.5-72b

# The query encoder. This is NOT a free choice: it must match what the corpus
# was embedded with, or similarities are meaningless and the failure is silent.
# The app checks it against rag.chunks_meta and warns on a mismatch.
#URBAN_RAG_EMBEDDING_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------------
# The database — pick ONE of the three
# ---------------------------------------------------------------------------

# 1. A full URL. What `make db-up` gives you, and what an open tunnel needs.
#    Append ?sslmode=disable for a container that speaks no TLS.
#DATABASE_URL=postgresql://urban_rag:urban_rag@localhost:5432/urban_rag?sslmode=disable

# 2. The dataplatform's contract. `eval "$(make -s db-app-env ENV=dev)"` in
#    hbu_infra sets all of these for you.
#URBAN_RAG_PG_HOST=hbu-dev.abcdef.us-east-1.rds.amazonaws.com
#    Through an hbu_infra db-tunnel, leave HOST naming the endpoint (the
#    certificate is issued to it) and point HOSTADDR at the local port, so
#    verify-full keeps working. `make run-tunnel` sets both for you.
#URBAN_RAG_PG_HOSTADDR=127.0.0.1
#URBAN_RAG_PG_PORT=5432
#URBAN_RAG_PG_DATABASE=urban_rag
#URBAN_RAG_PG_USER=urban_rag
#URBAN_RAG_PG_SECRET_ID=arn:aws:secretsmanager:us-east-1:...:secret:hbu-dev-app
#URBAN_RAG_PG_IAM_AUTH=0
#URBAN_RAG_PG_SSLMODE=verify-full

# 3. Nothing at all. With AWS credentials the endpoint is discovered from SSM
#    /hbu-<env>/db/* and the password from the app-role secret. These pick the
#    prefix; both have the defaults shown.
#HBU_PROJECT=hbu
#HBU_ENV=dev
#AWS_REGION=us-east-1

# `verify-full` needs Amazon's CA bundle on disk. `make db-ca` in hbu_infra
# puts it where libpq looks by default, so this is only for a different path.
#URBAN_RAG_PG_SSLROOTCERT=/home/you/.postgresql/root.crt

# Which schemas to read. `rag` holds what the scrape loaded — the lots, the
# buildings, the map features, the corpus; `silver` holds the joins the
# pipeline precomputed between them; `gold` holds its answers, of which this
# app reads one — gold.lot_building_massing, the Proposed massing layer. Three
# settings rather than one because they really are three schemas, and a review
# copy may rename only one of them.
#URBAN_RAG_PG_SCHEMA=rag
#URBAN_RAG_PG_SILVER_SCHEMA=silver
#URBAN_RAG_PG_GOLD_SCHEMA=gold

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "dev" shows the log pane in the sidebar. Set to "prod" to hide it.
APP_ENV=dev
LOG_LEVEL=INFO

# Zoning grid PDFs are cached on disk, keyed exactly as the dataplatform keys
# them — point this at its cache to reuse the ~600 files it already downloaded.
#HBU_PDF_CACHE_DIR=../hbu_dataplatform/data/cache/pdf
# The grid a lot links to is served back at /tiles/grid/<doc_id>.pdf, so the
# pane can frame it rather than only rasterise it. How tall that viewer is, in
# pixels, and how many freshly fetched documents stay addressable in memory
# when the cache directory is not writable.
#HBU_GRID_VIEWER_HEIGHT=600
#HBU_PDF_PUBLISHED_LIMIT=32
# Montreal's grids are http:// links and verify no certificate; Quebec City
# serves its from https://carte.ville.quebec.qc.ca, which a TLS-inspecting
# corporate proxy does intercept. Unset, the fetcher falls back in order to
# REQUESTS_CA_BUNDLE, CURL_CA_BUNDLE and SSL_CERT_FILE, taking the first that
# names a file that exists — so a machine that already sets SSL_CERT_FILE for
# the HuggingFace client needs nothing here. Set it only to point the document
# fetcher somewhere else than the rest of the app.
#URBAN_RAG_CA_BUNDLE=/etc/ssl/certs/aws-ca-bundle.pem

# ---------------------------------------------------------------------------
# The map's geometry
# ---------------------------------------------------------------------------
# Layers are drawn as vector tiles, read by the browser out of PMTiles
# archives the dataplatform's `map_tiles` asset writes - one file per layer
# per (scrape_date, borough) - with HTTP range requests, so no tile ever
# passes through this process or the database.
#
# Where the archives are. Three shapes:
#   s3://<bucket>/<env>/gold/map_tiles   the pipeline's bucket; every archive
#                                        URL is presigned with this process's
#                                        own AWS credentials (the profile
#                                        below on a laptop, the task role on
#                                        Fargate), and the bucket needs the
#                                        CORS rule hbu_infra/tiles.tf sets
#   https://host/prefix                  used as given
#   /path/to/hbu_dataplatform/data/gold/map_tiles
#                                        the local tree, served from the port
#                                        below with byte-range support
# Unset, the map draws the GeoJSON fallback and says so in the sidebar.
#HBU_TILES_URL=s3://urban-rag-dataplatform/dev/gold/map_tiles
# How long a presigned archive URL is good for; one is reused for half of
# this so a rerun does not hand the browser a new address for bytes it holds.
#HBU_TILES_PRESIGN_SECONDS=3600
# The bucket's region, for the signature. Falls back to AWS_REGION.
#HBU_TILES_REGION=us-east-1
# How long "which archives exist for this snapshot" is trusted, in seconds.
#HBU_TILES_MANIFEST_TTL=60
#
# "tiles" (the default) or "geojson". The GeoJSON renderer fetches every shape
# in the viewport into the page and is capped at HBU_MAP_FEATURE_LIMIT below;
# it is the fallback, not a mode to run in. The app selects it by itself, and
# says so in the sidebar, when HBU_TILES_URL is unset, when no archive has
# been built for the snapshot, or when the port below cannot be taken.
#HBU_MAP_RENDERER=tiles
# The second port: the vector renderer's own JavaScript, the zoning grid PDFs
# the Regulations pane publishes, and a local archive when HBU_TILES_URL is a
# directory. It has to be reachable from the browser, so a container run has
# to publish it — `make docker-run` does.
#HBU_TILE_PORT=8502
# What the browser prefixes those URLs with. Unset, an absolute
# http://localhost:<port>, which is what a laptop needs: Streamlit is on 8501
# and that server on 8502, two origins. Set to an empty value (or
# "same-origin") behind a load balancer that routes /tiles/* to this task, so
# the URLs come out relative and nothing has to know the DNS name;
# hbu_infra/ecs.tf sets it that way.
#HBU_TILE_BASE_URL=
# Set to 0 to not start the server at all. The renderer then falls back.
#HBU_TILE_ENABLED=1
# How long a browser may keep a locally served archive's bytes.
#HBU_TILE_CACHE_SECONDS=3600

# The GeoJSON renderer's cap, per layer per viewport query. Nothing to do with
# tiles, which are bounded by their own area.
#HBU_MAP_FEATURE_LIMIT=2000
#HBU_PG_STATEMENT_TIMEOUT_MS=20000

# Basemap tiles. Unset, the map uses OpenStreetMap and needs no account.
# Set MAPBOX_TOKEN to a *public* token (pk....) to switch to Mapbox — its
# light-v11 style is the pale background parcel lines read best against, and it
# replaced CartoDB Positron, which now requires a Carto account.
#   https://account.mapbox.com/access-tokens/  — restrict it to your domain(s)
#MAPBOX_TOKEN=pk.your_public_mapbox_token
# "auto" (default) uses Mapbox when the token is set, OpenStreetMap otherwise.
# Force one with "mapbox" or "osm".
#MAP_TILE_PROVIDER=auto
# The Mapbox base style, as "<account>/<style-id>".
#MAPBOX_STYLE=mapbox/light-v11

# A third basemap, on top of whichever of the two above is in use. Unset --
# the default -- it is the MERN's Imagerie continue, the province's orthophoto
# mosaic, which needs no account; so this is an override, and the way to turn
# the layer off is to set it to nothing:
#MAP_WMTS_URL=
#
# A RESTful WMTS fits here with no plugin, but its path is NOT in XYZ order:
# it ends {TileMatrixSet}/{TileMatrix}/{TileRow}/{TileCol}, i.e. {z}/{y}/{x}.
# Written {z}/{x}/{y} the tiles still load and are transposed. The matrix set
# has to be a Web-Mercator one (GoogleMapsCompatible / ...Ext2 : epsg:3857).
#MAP_WMTS_URL=https://servicesmatriciels.mern.gouv.qc.ca/erdas-iws/ogc/wmts/Imagerie_Continue/Imagerie_GQ/default/GoogleMapsCompatibleExt2:epsg:3857/{z}/{y}/{x}.jpg
# What the layer control calls it, and the attribution the map must carry.
#MAP_WMTS_NAME=Orthophoto
#MAP_WMTS_ATTR=(c) Gouvernement du Quebec (MERN)

# Which scraped layer carries the link to a zoning grid, and in which
# attribute. Mirrors DOCUMENT_SOURCES in the dataplatform; change both together.
#HBU_ZONING_SOURCE_TABLE=Reglement_urbanisme__VSP_REG_ZONE
#HBU_ZONING_URL_ATTRIBUTE=LIEN_GRILLE

# Where a city serves a zone's grid when its layer carries no link to one, as
# slug=template pairs formatted with {zone}. Montreal has no entry and needs
# none - its polygons carry the URL. Quebec City carries no such attribute and
# serves a grid per zone from a handler keyed on the code, so the link is
# derivable where it is not recorded. Tried after the corpus, so a URL that was
# actually indexed still wins.
#HBU_ZONING_PDF_URL_TEMPLATES=Zonage__ZONAGE_EN_VIGUEUR=https://carte.ville.quebec.qc.ca/GrillesZonage/HandlerZonage.ashx?{zone}

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# One shared password, checked in the app before anything queries the database.
# Unset -- which is the default here -- the gate is off entirely, so `make run`
# and the tests behave exactly as they always have.
#
# The deployed task always has it: hbu_infra/ecs.tf injects it from Secrets
# Manager, and `make app-password ENV=dev` in hbu_infra is what sets the value.
# Note what it is not: it authenticates access, not people. Nothing records who
# asked a question, and revoking one person means changing it for everyone.
#
# It also guards the tile endpoint, which is on its own port and therefore
# behind no form: every tile URL carries an HMAC of this password, and the tile
# server refuses a request without it. Unset, both gates are off together —
# there is no configuration in which the map is reachable and the app is not.
#HBU_APP_PASSWORD=
